      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Process Ultrasonic & Vehicle Data (V2)",
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "// V2 (R3/R11): ngưỡng zone lấy từ firmware/shared/thresholds.h —\n//   caution_cm = 100, danger_cm = 30\n// Telemetry sensor-node V2: d1..d6 (6 slot) + nearest_cm + has_nearest.\nvar dist = null;\nif (typeof msg.has_nearest !== 'undefined' && msg.has_nearest === true && msg.nearest_cm != null) {\n    dist = parseFloat(msg.nearest_cm);\n} else {\n    var vals = [msg.d1, msg.d2, msg.d3, msg.d4, msg.d5, msg.d6];\n    for (var i = 0; i < vals.length; i++) {\n        if (typeof vals[i] !== 'undefined' && vals[i] !== null) {\n            var v = parseFloat(vals[i]);\n            if (dist === null || v < dist) { dist = v; }\n        }\n    }\n}\n\nvar inRange = dist !== null && dist > 0;\nvar warningStatus = (inRange && dist <= 30.0) ? \"DANGER\"\n                  : (inRange && dist <= 100.0) ? \"CAUTION\"\n                  : \"NORMAL\";\nvar isVehicleDetected = inRange && dist <= 100.0;\nvar relayState = isVehicleDetected ? \"ON\" : \"OFF\";\n// Buzzer vật lý gắn trên sensor-node; field này chỉ phản ánh trạng thái hiển thị.\nvar buzzerState = relayState;\n\nvar newMsg = {\n    \"vehicle_detected\": isVehicleDetected,\n    \"warning_status\": warningStatus,\n    \"relay\": relayState,\n    \"buzzer\": buzzerState,\n    \"nearest_cm\": dist,\n    \"source_device\": \"sensor-node\"\n};\n\nreturn { msg: newMsg, metadata: metadata, msgType: \"POST_ATTRIBUTES_REQUEST\" };\n",
          "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
          "description": "Standardizes ultrasonic distance, temperature, humidity, vehicle detection, and relay state.",
          "layoutX": 450,
          "layoutY": 350
        }
